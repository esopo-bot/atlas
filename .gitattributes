# A cópia de skills é gerada pelo montar.py — colapsa nos diffs do GitHub.
.claude/skills/** linguist-generated=true

# O instalador é código escrito à mão desde que a carga saiu dele: ele lê a
# camada desta pasta. O fim de linha segue fixo em LF, como na fatia que tirou
# o ruído de fim de linha, para a árvore antiga que recebe a mescla não voltar
# a ver o arquivo modificado com diff vazio.
montar.py text eol=lf

# As cópias em uso dos módulos são regravadas pelo --sincronizar a partir
# da fonte em modulos/ — o diff que interessa é o da fonte.
.agents/encadeador/encadeador.py linguist-generated=true -diff
.agents/encadeador/testes.py linguist-generated=true -diff
.agents/auditor/auditor.py linguist-generated=true -diff

# O manual em HTML e gerado das paginas de conhecimento/ pelo
# .agents/manual/manual.py --escrever. Colapsa nos diffs do GitHub.
manual.html linguist-generated=true

# O lançador dos ganchos é lido pelo bash, que não aceita quebra de linha CRLF.
.claude/hooks/interpretador.sh text eol=lf
